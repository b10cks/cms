{
    "name": "b10cks/cms",
    "type": "project",
    "description": "An opinionated headless CMS built on Laravel",
    "keywords": ["cms", "headless", "laravel"],
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "ext-zlib": "*",
        "coderscantina/laravel-filter": "^1.3",
        "guzzlehttp/guzzle": "^7.9",
        "james-heinrich/getid3": "^1.9",
        "jcupitt/vips": "^2.5",
        "laravel/framework": "^12.19",
        "laravel/octane": "^2.10",
        "laravel/pennant": "^1.17",
        "laravel/reverb": "^1.5",
        "laravel/sanctum": "^4.1",
        "laravel/tinker": "^2.10",
        "league/flysystem-aws-s3-v3": "^3.29",
        "mews/purifier": "^3.4",
        "nikic/php-parser": "^5.7",
        "openai-php/laravel": "^0.18.0",
        "php-ffmpeg/php-ffmpeg": "^1.3",
        "posthog/posthog-php": "^3.6",
        "staudenmeir/eloquent-json-relations": "^1.14",
        "tymon/jwt-auth": "^2.2"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.15",
        "barryvdh/laravel-ide-helper": "^3.5",
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.23",
        "laravel/sail": "^1.43",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "phpunit/phpunit": "^11.5",
        "spatie/laravel-ignition": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan docs:generate --ansi || true"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate --ansi",
            "@php artisan ide-helper:meta --ansi",
            "@php artisan docs:generate --ansi || true"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
