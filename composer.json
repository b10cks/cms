{
  "name": "b10cks/cms",
  "type": "project",
  "description": "An opinionated headless CMS built on Laravel",
  "keywords": [
    "cms",
    "headless",
    "laravel"
  ],
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": "^8.5",
    "ext-pdo": "*",
    "ext-zlib": "*",
    "coderscantina/laravel-filter": "^2.0",
    "guzzlehttp/guzzle": "^7.9",
    "james-heinrich/getid3": "^1.9",
    "jcupitt/vips": "^2.5",
    "laravel/framework": "^13.6",
    "laravel/octane": "^2.10",
    "laravel/pennant": "^1.17",
    "laravel/reverb": "^1.5",
    "laravel/sanctum": "^4.0",
    "laravel/socialite": "^5.26",
    "laravel/tinker": "^3.0",
    "league/flysystem-aws-s3-v3": "^3.29",
    "mews/purifier": "^3.4",
    "nikic/php-parser": "^5.7",
    "onelogin/php-saml": "^4.2",
    "openai-php/laravel": "^0.19",
    "php-ffmpeg/php-ffmpeg": "^1.3",
    "phpoffice/phpspreadsheet": "^5.8",
    "posthog/posthog-php": "^4.0",
    "staudenmeir/eloquent-json-relations": "^1.15"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^4.1",
    "barryvdh/laravel-ide-helper": "^3.5",
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.23",
    "laravel/sail": "^1.43",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.8",
    "phpunit/phpunit": "^13.0",
    "spatie/laravel-ignition": "^2.9"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "bun install",
      "bun run build"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=server,queue,logs,vite --kill-others"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan docs:generate --ansi || true"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
      "@php artisan ide-helper:generate --ansi",
      "@php artisan ide-helper:meta --ansi",
      "@php artisan docs:generate --ansi || true"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
