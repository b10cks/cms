APP_NAME="b10cks CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://b10cks.test
APP_DOMAIN=b10cks.test
SANCTUM_STATEFUL_DOMAINS=app.b10cks.test,b10cks.test,localhost,127.0.0.1

# Host headers accepted in addition to APP_URL and its subdomains, comma
# separated. Needed for health checks that hit the instance by IP.
TRUSTED_HOSTS=
# CIDR range of the load balancer, or "*" if the app is only reachable through
# it. Empty means no proxy is trusted and every request appears to come from
# the balancer, which merges all per-IP rate limits into one bucket.
TRUSTED_PROXIES=

DEBUGBAR_ENABLED=true
IMAGE_DRIVER=imagick

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_STACK=daily

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_RO_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

DB_DUMPER=mysqldump

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@b10cks.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_TRANSFERS_BUCKET=
AWS_TRANSFERS_URL=

CLOUDFRONT_LOG_BUCKET=

OCTANE_SERVER=frankenphp

REVERB_APP_ID=123456
REVERB_APP_KEY=b10cks-local-key
REVERB_APP_SECRET=b10cks-local-secret
REVERB_HOST=b10cks.test
REVERB_PORT=8080
REVERB_SCHEME=http

JWT_SECRET=

FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

AI_MODE=space
AI_DEFAULT_DRIVER=openrouter
OPENROUTER_ENABLED=true
OPENROUTER_MANAGEMENT_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
OPENROUTER_PROVISION_DEMO_KEYS=true
OPENROUTER_DEMO_KEY_LIMIT=2.0
OPENROUTER_DEMO_KEY_EXPIRY_DAYS=30
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
BEDROCK_ENABLED=false

VITE_APP_API_PROXY_URL=https://api.b10cks.test
IMAGE_BASE_URL=https://api.b10cks.test/ilum

LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/v1/social/google/callback"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/v1/social/github/callback"
